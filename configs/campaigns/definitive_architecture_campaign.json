{
  "campaign_id": "cpso_architecture_campaign_v1",
  "title": "Confirmatory study of CPSO parallel execution architectures",
  "schedule_seed": 20261105,
  "study_notes": {
    "design": "Paired seeds within benchmark \u00d7 dimension problem instances; 30 independent seeds for search-quality stages and 10 for timing stage.",
    "fixed_quality_budget": "N=64, K=500, FE=N(K+1)=32064 for every method including islands.",
    "fixed_scaling_budget": "K=80, FE=N(K+1), with N=64 or 128.",
    "quality_target": "Predeclared target 1e-8 for functions with global optimum 0; ERT is censored at budget for unsuccessful runs.",
    "worker_counts": "1,2,4,8; reduce these in the JSON configuration if the target host has fewer available logical CPUs.",
    "suite_scope": "Built-in analytic functions are architecture-study benchmarks only. sphere_work is a synthetic timing instrument and must not be counted as a standard optimization benchmark.",
    "external_suite_gate": "Before a final journal submission, integrate/version-pin COCO/BBOB and CEC 2013 LSGO with native objective adapters and validate official FE accounting. This campaign does not claim external-suite results."
  },
